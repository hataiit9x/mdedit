# ---------------------------------------------------------------------------
# GEMINI_API_KEY (optional): shared server-side key for the Gemini proxy.
# AI Studio automatically injects this at runtime from user secrets.
# When present, users of the deployed app get zero-config AI through
# /api/gemini/* and the key never reaches the browser. When absent (or when
# the app is opened as a static site without server.ts), each user falls back
# to their own BYOK key stored encrypted in the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# OpenAI-compatible provider (optional): configure these to give the deployed
# app a SHARED OpenAI-compatible key kept server-side (routed through
# /api/openai/*). Works with OpenAI, OpenRouter, Groq, DeepSeek, or any
# endpoint exposing POST {base}/chat/completions.
#
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#
# Note: a LOCAL endpoint (e.g. Ollama at http://localhost:11434/v1) is only
# reachable when the server itself runs locally — from a Cloud Run deployment
# "localhost" points at the Cloud Run machine. Users with their own key
# always call their endpoint directly from the browser instead.
#
# On AI Studio: add these in the app's Secrets panel — they are injected as
# environment variables at runtime, exactly like GEMINI_API_KEY.
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
